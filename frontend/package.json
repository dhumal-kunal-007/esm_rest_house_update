{
  "name": "frontend",
  "private": true,
  "version": "0.1.2",
  "description": "Desktop booking and management system for ESM Rest House.",
  "author": "ESM Rest House",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix ../backend run dev\" \"vite\" \"wait-on http://localhost:5173 http://localhost:5000/api/health && electron .\"",
    "build": "tsc -b && vite build",
    "package:win": "npm run build && npm --prefix ../backend run build && node scripts/prepare-backend.cjs && npm install --omit=dev --prefix desktop-backend-build && electron-builder --win nsis",
    "release:win": "npm run build && npm --prefix ../backend run build && node scripts/prepare-backend.cjs && npm install --omit=dev --prefix desktop-backend-build && electron-builder --win nsis --publish always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "gov.maharashtra.esmresthouse",
    "productName": "ESM Rest House",
    "compression": "normal",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-auto-update"
    },
    "extraResources": [
      {
        "from": "desktop-backend-build/dist",
        "to": "backend/dist"
      },
      {
        "from": "desktop-backend-build/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "desktop-backend-build/package.json",
        "to": "backend/package.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dhumal-kunal-007",
        "repo": "esm_rest_house_update",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
